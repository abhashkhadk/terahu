# Google AdSense Configuration
GOOGLE_ADSENSE_PUBLISHER_ID=ca-pub-YOUR_PUBLISHER_ID_HERE
GOOGLE_ADSENSE_HEADER_SLOT=YOUR_HEADER_SLOT_ID
GOOGLE_ADSENSE_SIDEBAR_SLOT=YOUR_SIDEBAR_SLOT_ID
GOOGLE_ADSENSE_FEED_SLOT=YOUR_FEED_SLOT_ID

# Firebase Configuration
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Ad Placement Configuration
AD_HEADER_ENABLED=true
AD_HEADER_SIZE=728x90
AD_SIDEBAR_ENABLED=true
AD_SIDEBAR_SIZE=300x250
AD_FEED_ENABLED=false
AD_FEED_SIZE=300x250
AD_FEED_INTERVAL=3

# Application Settings
APP_NAME=TeraHub
APP_ENVIRONMENT=production
APP_DEBUG=false
